{
  "name": "prevision-desktop",
  "productName": "预见 PreVision",
  "version": "0.8.0",
  "description": "面向 AI 电影创作者的 3D 分镜预演桌面工具",
  "main": "electron/main.cjs",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "build": "node scripts/build-app.mjs",
    "dev": "node scripts/build-app.mjs --watch",
    "test": "npm run test:core",
    "test:core": "node 测试/冒烟测试.mjs --core",
    "test:module": "node 测试/冒烟测试.mjs --module",
    "test:app": "node 测试/冒烟测试.mjs",
    "test:project-input": "node scripts/run-project-input-probe.mjs",
    "test:project-input-wrapper": "node 测试/项目输入探针启动测试.mjs",
    "test:desktop": "node 测试/桌面壳测试.mjs",
    "test:local-install": "node 测试/本地应用安装测试.mjs && node 测试/本地交付门禁测试.mjs",
    "test:i18n": "node 测试/国际化测试.mjs",
    "test:web": "node 测试/Web运行底座测试.mjs && node 测试/Web压力测试工装测试.mjs",
    "test:web:stress-harness": "node 测试/Web压力测试工装测试.mjs",
    "test:coordination": "node 测试/并行任务协调测试.mjs",
    "test:foundation": "node 测试/仓库基础测试.mjs && node 测试/回归/C8_build_gate.mjs && npm run test:coordination && npm run test:i18n && npm run test:project-input-wrapper",
    "test:full": "npm run test:app && npm run test:project-input && npm run test:web && npm run test:desktop && npm run test:local-install && npm run test:foundation",
    "test:impact": "node 测试/影响范围测试.mjs",
    "web:build": "node scripts/build-web.mjs",
    "web:preview": "node scripts/preview-web.mjs",
    "web:stress:check": "node scripts/run-web-stress.mjs --check",
    "web:stress": "node scripts/run-web-stress.mjs",
    "package": "electron-forge package --platform=darwin --arch=arm64",
    "app:update": "node scripts/update-local-app.mjs",
    "app:status": "node scripts/local-app-status.mjs",
    "app:deliver": "node scripts/deliver-local-app.mjs",
    "preview:launcher:install": "node scripts/install-latest-preview-launcher.mjs",
    "preview:publish": "node scripts/publish-latest-preview.mjs",
    "test:latest-preview": "node 测试/最新预览入口测试.mjs",
    "preview:lan:install": "node scripts/install-latest-preview-lan-service.mjs install",
    "preview:lan:start": "node scripts/install-latest-preview-lan-service.mjs start",
    "preview:lan:stop": "node scripts/install-latest-preview-lan-service.mjs stop",
    "preview:lan:restart": "node scripts/install-latest-preview-lan-service.mjs restart",
    "preview:lan:status": "node scripts/install-latest-preview-lan-service.mjs status",
    "preview:lan:uninstall": "node scripts/install-latest-preview-lan-service.mjs uninstall",
    "test:latest-preview-lan": "node 测试/局域网最新预览测试.mjs",
    "task:status": "node scripts/task-coordination.mjs status",
    "task:check": "node scripts/task-coordination.mjs check",
    "task:reserve": "node scripts/task-coordination.mjs reserve",
    "task:claim": "node scripts/task-coordination.mjs claim",
    "task:transition": "node scripts/task-coordination.mjs transition",
    "task:verify-stop": "node scripts/task-coordination.mjs verify-stop",
    "task:cancel-reservation": "node scripts/task-coordination.mjs cancel-reservation",
    "task:resolve-integrity": "node scripts/task-coordination.mjs resolve-integrity",
    "task:migrate-legacy-worktree": "node scripts/task-coordination.mjs migrate-legacy-worktree",
    "task:release": "node scripts/task-coordination.mjs release",
    "task:archive": "node scripts/task-coordination.mjs archive",
    "make": "npm run make:mac",
    "make:mac": "electron-forge make --platform=darwin --targets=@electron-forge/maker-zip",
    "make:mac:dmg": "electron-forge make --platform=darwin --targets=@electron-forge/maker-dmg"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron/asar": "3.4.1",
    "electron": "43.1.0",
    "esbuild": "0.28.1"
  }
}
