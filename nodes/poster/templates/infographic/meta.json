    { "id": "subtext",  "type": "text",  "text": "次要说明文字", "label": "次要文本",   "x": 0.06, "y": 0.72, "w": 0.52, "h": 0.16, "font": "body", "font_size": 14, "line_height": 1.7, "align": "justify", "color": "muted" }
  ]
